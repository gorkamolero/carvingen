{
  "project": {
    "name": "Image prompt mesh",
    "mode": "create"
  },
  "assets": [
    {
      "id": "sketch",
      "path": "./examples/assets/sketch.png",
      "kind": "image"
    }
  ],
  "nodes": [
    {
      "id": "image_sketch",
      "type": "image",
      "position": { "x": 100, "y": 180 },
      "asset": "sketch"
    },
    {
      "id": "prompt_refine",
      "type": "prompt",
      "position": { "x": 480, "y": 160 },
      "run": true,
      "data": {
        "text": "Refine this into a single clean walnut carving concept on a neutral background",
        "model": "fal-ai/nano-banana-2",
        "aspectRatio": "1:1",
        "resolution": "1K",
        "seed": null
      }
    },
    {
      "id": "mesh_preview",
      "type": "mesh",
      "position": { "x": 880, "y": 180 },
      "run": true,
      "data": {
        "provider": "meshy",
        "mode": "preview",
        "meshyUseMultiview": false,
        "meshyPolyMode": "low",
        "meshyTargetPolycount": 3000,
        "meshyTopology": "triangle",
        "meshySymmetryMode": "auto",
        "meshyPoseMode": "",
        "meshyEnableRigging": false,
        "meshyRiggingHeightMeters": 1.7,
        "meshyEnableAnimation": false,
        "meshyAnimationActionId": 1001
      }
    }
  ],
  "edges": [
    { "source": "image_sketch", "sourceHandle": "image-out", "target": "prompt_refine", "targetHandle": "image-in" },
    { "source": "prompt_refine", "sourceHandle": "image-out", "target": "mesh_preview", "targetHandle": "image-in" }
  ],
  "viewport": { "x": 0, "y": 0, "zoom": 1 }
}
