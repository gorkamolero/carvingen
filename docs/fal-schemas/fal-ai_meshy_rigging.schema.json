{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/meshy/rigging",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/meshy/rigging queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/meshy/rigging",
      "category": "3d-to-3d",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9ae24d/XIUgczEpCoC7-xcZRvqbu_c31adb5b44304f35a23d70458c77aa31.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/meshy/rigging",
      "documentationUrl": "https://fal.ai/models/fal-ai/meshy/rigging/api",
      "about": "Auto-rig and optionally animate any 3D humanoid model (GLB format).\n\nAccepts any publicly accessible GLB URL \u2014 works with models generated\nby Hunyuan, Trellis, Meshy, or any other 3D generation tool.\n\nFeatures:\n- Automatic humanoid rigging with skeleton\n- Basic walking and running animations included\n- Optional animation presets from Meshy's 500+ preset library\n- Output in both GLB and FBX formats\n- Processing time: 1-3 minutes"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "MeshyRiggingInput": {
        "title": "RiggingInput",
        "x-fal-order-properties": [
          "model_url",
          "height_meters",
          "enable_animation",
          "animation_action_id",
          "enable_safety_checker"
        ],
        "required": [
          "model_url"
        ],
        "description": "Input for standalone auto-rigging and animation of a 3D model",
        "type": "object",
        "properties": {
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "If set to true, input data will be checked for safety before processing.",
            "default": true,
            "type": "boolean"
          },
          "enable_animation": {
            "title": "Enable Animation",
            "description": "Apply an animation preset to the rigged model.",
            "default": false,
            "type": "boolean"
          },
          "height_meters": {
            "title": "Height Meters",
            "exclusiveMinimum": 0,
            "description": "Approximate height of the character in meters.",
            "default": 1.7,
            "type": "number"
          },
          "model_url": {
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/video_models/base_basic_shaded.glb"
            ],
            "description": "URL of a 3D model in GLB format to rig. Can be any publicly accessible URL \u2014 works with models generated by Hunyuan, Trellis, Meshy, or any other 3D generation tool. The model must be a humanoid character with clearly defined limbs.",
            "minLength": 1,
            "type": "string",
            "title": "Model Url"
          },
          "animation_action_id": {
            "title": "Animation Action Id",
            "examples": [
              92
            ],
            "description": "Animation preset ID from Meshy's library. Only used when enable_animation is true; in that case it must be in [0, 696] (``0`` is the \"Idle\" preset) and is otherwise rejected with a 422. See https://docs.meshy.ai/en/api/animation-library for available action IDs.",
            "default": 92,
            "type": "integer"
          }
        }
      },
      "MeshyRiggingOutput": {
        "properties": {
          "rigged_character_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rigged character in FBX format."
          },
          "rigged_character_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rigged character in GLB format."
          },
          "rig_task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Meshy rigging task ID.",
            "title": "Rig Task Id"
          },
          "animation_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Animated 3D model in FBX format. Only present when enable_animation is true."
          },
          "basic_animations": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BasicAnimations"
              },
              {
                "type": "null"
              }
            ],
            "description": "Basic walking and running animations included with rigging."
          },
          "animation_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Animated 3D model in GLB format. Only present when enable_animation is true."
          }
        },
        "title": "RiggingOutput",
        "description": "Output for standalone auto-rigging and animation",
        "x-fal-order-properties": [
          "rigged_character_glb",
          "rigged_character_fbx",
          "basic_animations",
          "animation_glb",
          "animation_fbx",
          "rig_task_id"
        ],
        "type": "object"
      },
      "File": {
        "title": "File",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          }
        }
      },
      "BasicAnimations": {
        "properties": {
          "running_armature_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running armature only in GLB format"
          },
          "walking_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking animation in FBX format"
          },
          "running_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running animation in GLB format"
          },
          "walking_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking animation in GLB format"
          },
          "walking_armature_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking armature only in GLB format"
          },
          "running_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running animation in FBX format"
          }
        },
        "title": "BasicAnimations",
        "description": "Basic animation files included with the rigging result",
        "x-fal-order-properties": [
          "walking_glb",
          "walking_fbx",
          "walking_armature_glb",
          "running_glb",
          "running_fbx",
          "running_armature_glb"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/fal-ai/meshy/rigging/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/meshy/rigging/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/meshy/rigging": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeshyRiggingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/meshy/rigging/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshyRiggingOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
